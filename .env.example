# Which LLM provider to use: "mock" (offline, deterministic) or "anthropic"
SWITCHBOARD_PROVIDER=mock

# Required only when SWITCHBOARD_PROVIDER=anthropic (or log in with `ant auth login`)
ANTHROPIC_API_KEY=

# Optional overrides for the `model:` section of the config. Empty = use config value.
SWITCHBOARD_MODEL=
SWITCHBOARD_MAX_TOKENS=
SWITCHBOARD_EFFORT=
SWITCHBOARD_THINKING=
# Only sent when SWITCHBOARD_API_VERSION pins an older API version that accepts it
SWITCHBOARD_TEMPERATURE=
SWITCHBOARD_API_VERSION=
SWITCHBOARD_TIMEOUT_S=
SWITCHBOARD_MAX_RETRIES=

# Router runtime (all optional)
# Config file; default configs/banking.yaml
SWITCHBOARD_CONFIG=
# Customer id when a request doesn't name one (demo data: cust_001, cust_002)
SWITCHBOARD_DEFAULT_CUSTOMER=
# Defaults: logs/decisions.jsonl, logs/human_queue.jsonl, data/fixtures/accounts.json
SWITCHBOARD_DECISION_LOG_PATH=
SWITCHBOARD_HUMAN_QUEUE_PATH=
SWITCHBOARD_ACCOUNTS_PATH=
# "true" to include raw query text in the decision log (off by default: may contain PII)
SWITCHBOARD_LOG_QUERIES=
