# Which LLM provider to use: "mock" (offline, deterministic) or "anthropic"
SWITCHBOARD_PROVIDER=mock

# Required only when SWITCHBOARD_PROVIDER=anthropic (or log in with `ant auth login`)
ANTHROPIC_API_KEY=

# Optional overrides for the `model:` section of the config. Empty = use config value.
SWITCHBOARD_MODEL=
SWITCHBOARD_MAX_TOKENS=
SWITCHBOARD_EFFORT=
SWITCHBOARD_THINKING=
# Only sent when SWITCHBOARD_API_VERSION pins an older API version that accepts it
SWITCHBOARD_TEMPERATURE=
SWITCHBOARD_API_VERSION=
SWITCHBOARD_TIMEOUT_S=
SWITCHBOARD_MAX_RETRIES=
